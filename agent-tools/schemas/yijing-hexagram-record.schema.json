{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YijingHexagramRecord",
  "type": "object",
  "required": [
    "question_text",
    "casting_method",
    "cast_time",
    "timezone",
    "line_order",
    "lines",
    "base_hexagram",
    "changing_lines",
    "changed_hexagram",
    "is_valid",
    "errors",
    "warnings",
    "next_steps"
  ],
  "properties": {
    "question_text": {"type": "string"},
    "casting_method": {"type": "string"},
    "cast_time": {"type": "string"},
    "timezone": {"type": "string"},
    "line_order": {"type": "string", "enum": ["bottom_to_top"]},
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "value", "yin_yang", "changing", "bit", "changed_bit", "label"],
        "properties": {
          "index": {"type": "integer", "minimum": 1, "maximum": 6},
          "value": {"type": "integer", "enum": [6, 7, 8, 9]},
          "yin_yang": {"type": "string", "enum": ["yin", "yang"]},
          "changing": {"type": "boolean"},
          "bit": {"type": "string", "enum": ["0", "1"]},
          "changed_bit": {"type": "string", "enum": ["0", "1"]},
          "label": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "base_hexagram": {"anyOf": [{"$ref": "#/$defs/hexagram"}, {"type": "null"}]},
    "changing_lines": {
      "type": "array",
      "items": {"type": "integer", "minimum": 1, "maximum": 6}
    },
    "changed_hexagram": {"anyOf": [{"$ref": "#/$defs/hexagram"}, {"type": "null"}]},
    "is_valid": {"type": "boolean"},
    "errors": {
      "type": "array",
      "items": {"type": "string"}
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    },
    "next_steps": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "trigram": {
      "type": "object",
      "required": ["bits", "name", "image", "symbol"],
      "properties": {
        "bits": {"type": "string"},
        "name": {"type": "string"},
        "image": {"type": "string"},
        "symbol": {"type": "string"}
      },
      "additionalProperties": false
    },
    "hexagram": {
      "type": "object",
      "required": ["number", "name", "bits_bottom_to_top", "lower_trigram", "upper_trigram"],
      "properties": {
        "number": {"type": "integer", "minimum": 1, "maximum": 64},
        "name": {"type": "string"},
        "bits_bottom_to_top": {"type": "string"},
        "lower_trigram": {"$ref": "#/$defs/trigram"},
        "upper_trigram": {"$ref": "#/$defs/trigram"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

