{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PendulumInterpretationPlanner",
  "type": "object",
  "required": ["tool", "is_valid", "can_continue_pendulum", "question_text", "risk_flags", "symbol_plans", "interpretation_layers", "synthesis", "limits", "next_steps"],
  "properties": {
    "tool": {"type": "string", "const": "pendulum_interpretation_planner"},
    "is_valid": {"type": "boolean"},
    "can_continue_pendulum": {"type": "boolean"},
    "question_text": {"type": "string"},
    "question_type": {"type": "string"},
    "answer_motion": {"type": "string"},
    "consent_confirmed": {"type": "boolean"},
    "calibration_notes": {"type": "string"},
    "risk_flags": {"type": "array", "items": {"type": "string"}},
    "missing_fields": {"type": "array", "items": {"type": "string"}},
    "symbol_plans": {"type": "array", "items": {"type": "object"}},
    "interpretation_layers": {"type": "array", "items": {"type": "string"}},
    "synthesis": {"type": "object"},
    "limits": {"type": "array", "items": {"type": "string"}},
    "next_steps": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
