{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DowsingContextRecorder",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "question_text": { "type": "string" },
    "request_text": { "type": "string" },
    "text": { "type": "string" },
    "tool_type": { "type": "string" },
    "rod_type": { "type": "string" },
    "observation_target": { "type": "string" },
    "target": { "type": "string" },
    "space_or_map": { "type": "string" },
    "location": { "type": "string" },
    "map": { "type": "string" },
    "movement_notes": { "type": ["string", "array"], "items": { "type": "string" } },
    "movements": { "type": ["string", "array"], "items": { "type": "string" } },
    "authorization_context": { "type": "string" },
    "authorization": { "type": "string" },
    "focus": { "type": "string" },
    "safety_context": { "type": ["string", "array"], "items": { "type": "string" } },
    "safety_notes": { "type": ["string", "array"], "items": { "type": "string" } },
    "reality_constraints": { "type": ["string", "array"], "items": { "type": "string" } },
    "constraints": { "type": ["string", "array"], "items": { "type": "string" } },
    "duration": { "type": "string" },
    "time_limit": { "type": "string" },
    "notes": { "type": "string" },
    "context_notes": { "type": "string" }
  },
  "anyOf": [
    { "required": ["question_text"] },
    { "required": ["request_text"] },
    { "required": ["text"] }
  ]
}
