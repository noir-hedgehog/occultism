{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NineStarKiInterpretationPlanner",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "question_text": { "type": "string" },
    "request_text": { "type": "string" },
    "text": { "type": "string" },
    "system_variant": { "type": "string" },
    "source": { "type": "string" },
    "focus": { "type": "string" },
    "birth_year": { "oneOf": [{ "type": "string" }, { "type": "integer" }] },
    "birth_month": { "oneOf": [{ "type": "string" }, { "type": "integer" }] },
    "current_year": { "oneOf": [{ "type": "string" }, { "type": "integer" }] },
    "home_star": { "type": "string" },
    "birth_star": { "type": "string" },
    "main_star": { "type": "string" },
    "month_star": { "type": "string" },
    "annual_star": { "type": "string" },
    "year_star": { "type": "string" },
    "directions": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
    "direction_focus": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
    "reality_constraints": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
    "constraints": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
    "notes": { "type": "string" },
    "profile_notes": { "type": "string" }
  },
  "anyOf": [
    { "required": ["question_text"] },
    { "required": ["request_text"] },
    { "required": ["text"] }
  ]
}
