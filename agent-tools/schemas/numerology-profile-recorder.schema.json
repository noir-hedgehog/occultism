{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NumerologyProfileRecorder",
  "type": "object",
  "required": ["tool", "system", "is_valid", "can_continue_numerology", "number_text", "number_context", "digits", "digit_count", "risk_flags", "missing_fields", "safety_notes", "next_steps"],
  "properties": {
    "tool": {"type": "string", "const": "numerology_profile_recorder"},
    "system": {"type": "string"},
    "is_valid": {"type": "boolean"},
    "can_continue_numerology": {"type": "boolean"},
    "number_text": {"type": "string"},
    "number_context": {"type": "string"},
    "digits": {"type": "array", "items": {"type": "string"}},
    "digit_count": {"type": "integer"},
    "risk_flags": {"type": "array", "items": {"type": "string"}},
    "missing_fields": {"type": "array", "items": {"type": "string"}},
    "safety_notes": {"type": "array", "items": {"type": "string"}},
    "next_steps": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
