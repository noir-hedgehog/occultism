{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HumanDesignInterpretationPlanner",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "question_text": { "type": "string" },
    "request_text": { "type": "string" },
    "text": { "type": "string" },
    "chart_source": { "type": "string" },
    "data_scope": { "type": "string" },
    "focus": { "type": "string" },
    "type": { "type": "string" },
    "human_design_type": { "type": "string" },
    "strategy": { "type": "string" },
    "authority": { "type": "string" },
    "inner_authority": { "type": "string" },
    "profile": { "type": "string" },
    "definition": { "type": "string" },
    "centers": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
    "defined_centers": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
    "channels": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
    "gates": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
    "reality_constraints": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
    "constraints": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
    "notes": { "type": "string" },
    "chart_notes": { "type": "string" }
  },
  "anyOf": [
    { "required": ["question_text"] },
    { "required": ["request_text"] },
    { "required": ["text"] }
  ]
}
