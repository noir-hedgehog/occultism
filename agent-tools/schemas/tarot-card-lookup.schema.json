{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TarotCardLookup",
  "type": "object",
  "required": [
    "card",
    "english_name",
    "arcana",
    "orientation",
    "position",
    "upright_keywords",
    "reversed_keywords",
    "active_keywords",
    "reflection_prompt",
    "action_guidance",
    "safety_note"
  ],
  "properties": {
    "card": {"type": "string"},
    "english_name": {"type": "string"},
    "arcana": {"type": "string", "enum": ["major", "minor"]},
    "number": {"type": "integer"},
    "suit": {"type": "string"},
    "rank": {"type": "string"},
    "element": {"type": "string"},
    "orientation": {"type": "string", "enum": ["upright", "reversed"]},
    "position": {"type": "string"},
    "upright_keywords": {"type": "array", "items": {"type": "string"}},
    "reversed_keywords": {"type": "array", "items": {"type": "string"}},
    "active_keywords": {"type": "array", "items": {"type": "string"}},
    "reflection_prompt": {"type": "string"},
    "action_guidance": {"type": "string"},
    "safety_note": {"type": "string"}
  },
  "additionalProperties": false
}

