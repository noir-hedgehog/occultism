{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DreamSymbolLookup",
  "type": "object",
  "required": [
    "tool",
    "query",
    "canonical_name",
    "symbol_code",
    "system",
    "symbol_layer",
    "keywords",
    "interpretation_prompt",
    "reflection_questions",
    "action_guidance",
    "prohibited_uses",
    "next_steps"
  ],
  "properties": {
    "tool": {"type": "string", "const": "dream_symbol_lookup"},
    "query": {"type": "string"},
    "canonical_name": {"type": "string"},
    "symbol_code": {"type": "string"},
    "system": {"type": "string", "const": "dream_symbolic_reflection"},
    "symbol_layer": {"type": "string"},
    "keywords": {"type": "array", "items": {"type": "string"}},
    "interpretation_prompt": {"type": "string"},
    "reflection_questions": {"type": "array", "items": {"type": "string"}},
    "action_guidance": {"type": "string"},
    "prohibited_uses": {"type": "array", "items": {"type": "string"}},
    "next_steps": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
