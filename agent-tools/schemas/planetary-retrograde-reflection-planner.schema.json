{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlanetaryRetrogradeReflectionPlanner",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "context_text": { "type": "string" },
    "request_text": { "type": "string" },
    "text": { "type": "string" },
    "retrograde_focus": { "type": "string" },
    "affected_areas": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "current_events": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "emotions": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "reality_constraints": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "practical_actions": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "review_time": { "type": "string" },
    "stop_condition": { "type": "string" },
    "focus": { "type": "string" }
  },
  "anyOf": [
    { "required": ["context_text"] },
    { "required": ["request_text"] },
    { "required": ["text"] }
  ]
}
