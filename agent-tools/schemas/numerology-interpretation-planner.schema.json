{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NumerologyInterpretationPlanner",
  "type": "object",
  "required": ["tool", "is_valid", "can_continue_numerology", "number_text", "number_context", "risk_flags", "symbol_plans", "interpretation_layers", "synthesis", "limits", "next_steps"],
  "properties": {
    "tool": {"type": "string", "const": "numerology_interpretation_planner"},
    "is_valid": {"type": "boolean"},
    "can_continue_numerology": {"type": "boolean"},
    "number_text": {"type": "string"},
    "number_context": {"type": "string"},
    "digits": {"type": "array", "items": {"type": "string"}},
    "risk_flags": {"type": "array", "items": {"type": "string"}},
    "missing_fields": {"type": "array", "items": {"type": "string"}},
    "symbol_plans": {"type": "array", "items": {"type": "object"}},
    "interpretation_layers": {"type": "array", "items": {"type": "string"}},
    "synthesis": {"type": "object"},
    "limits": {"type": "array", "items": {"type": "string"}},
    "next_steps": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
