{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentWorkflowRouter",
  "type": "object",
  "required": [
    "tool",
    "root",
    "is_valid",
    "request_text",
    "domain",
    "original_domain",
    "intent",
    "risk_level",
    "risk_signals",
    "route_status",
    "can_continue_mystic_workflow",
    "skill",
    "skill_path",
    "sop",
    "knowledge",
    "initial_tools",
    "domain_tools",
    "required_clarifications",
    "allowed_next_steps",
    "agent_instructions",
    "limits",
    "next_steps"
  ],
  "properties": {
    "tool": {"type": "string", "const": "agent_workflow_router"},
    "root": {"type": "string"},
    "is_valid": {"type": "boolean"},
    "request_text": {"type": "string"},
    "domain": {"type": "string"},
    "original_domain": {"type": "string"},
    "intent": {"type": "string"},
    "risk_level": {"type": "string"},
    "risk_signals": {"type": "array", "items": {"type": "string"}},
    "route_status": {
      "type": "string",
      "enum": ["ready_to_run_skill", "needs_domain_selection", "paused_for_professional_boundary", "blocked_safety"]
    },
    "can_continue_mystic_workflow": {"type": "boolean"},
    "skill": {"type": "string"},
    "skill_path": {"type": "string"},
    "sop": {"type": "array", "items": {"type": "string"}},
    "knowledge": {"type": "array", "items": {"type": "string"}},
    "initial_tools": {"type": "array", "items": {"type": "string"}},
    "domain_tools": {"type": "array", "items": {"type": "string"}},
    "required_clarifications": {"type": "array", "items": {"type": "string"}},
    "allowed_next_steps": {"type": "array", "items": {"type": "string"}},
    "agent_instructions": {"type": "array", "items": {"type": "string"}},
    "limits": {"type": "array", "items": {"type": "string"}},
    "next_steps": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
