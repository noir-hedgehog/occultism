{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QimenChartRecord",
  "type": "object",
  "required": [
    "question_text",
    "chart_time",
    "timezone",
    "location",
    "method",
    "dun",
    "ju",
    "duty_star",
    "duty_door",
    "day_stem",
    "hour_stem",
    "focus_targets",
    "palaces",
    "is_valid",
    "errors",
    "warnings",
    "next_steps"
  ],
  "properties": {
    "question_text": {"type": "string"},
    "chart_time": {"type": "string"},
    "timezone": {"type": "string"},
    "location": {"type": "string"},
    "method": {"type": "string"},
    "dun": {"type": "string"},
    "ju": {"type": ["integer", "null"], "minimum": 1, "maximum": 9},
    "duty_star": {"type": "string"},
    "duty_door": {"type": "string"},
    "day_stem": {"type": "string"},
    "hour_stem": {"type": "string"},
    "focus_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "palace", "reason"],
        "properties": {
          "label": {"type": "string"},
          "palace": {"type": "integer", "minimum": 0, "maximum": 9},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "palaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["palace", "trigram", "earth_stem", "heaven_stem", "door", "star", "deity", "notes"],
        "properties": {
          "palace": {"type": "integer", "minimum": 1, "maximum": 9},
          "trigram": {"type": "string"},
          "earth_stem": {"type": "string"},
          "heaven_stem": {"type": "string"},
          "door": {"type": "string"},
          "star": {"type": "string"},
          "deity": {"type": "string"},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "is_valid": {"type": "boolean"},
    "errors": {
      "type": "array",
      "items": {"type": "string"}
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    },
    "next_steps": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}

