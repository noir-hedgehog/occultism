{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ParadigmSelector",
  "type": "object",
  "required": [
    "tool",
    "root",
    "is_valid",
    "request_text",
    "domain",
    "domain_display_name",
    "intent",
    "risk_level",
    "route_status",
    "trunk",
    "question_type",
    "recommended_paradigm",
    "execution_boundary",
    "evidence_track",
    "context_files",
    "initial_tools",
    "limits",
    "next_steps"
  ],
  "properties": {
    "tool": {"type": "string", "const": "paradigm_selector"},
    "root": {"type": "string"},
    "is_valid": {"type": "boolean"},
    "request_text": {"type": "string"},
    "domain": {"type": "string"},
    "domain_display_name": {"type": "string"},
    "intent": {"type": "string"},
    "risk_level": {"type": "string", "enum": ["green", "yellow", "orange", "red"]},
    "route_status": {"type": "string"},
    "trunk": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"}
      },
      "additionalProperties": false
    },
    "question_type": {"type": "string"},
    "recommended_paradigm": {
      "type": "object",
      "required": ["id", "title", "why"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "why": {"type": "string"}
      },
      "additionalProperties": false
    },
    "execution_boundary": {
      "type": "object",
      "required": ["automation_mode", "automated_parts", "agent_required_parts", "human_review_recommended"],
      "properties": {
        "automation_mode": {"type": "string"},
        "automated_parts": {"type": "array", "items": {"type": "string"}},
        "agent_required_parts": {"type": "array", "items": {"type": "string"}},
        "human_review_recommended": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "evidence_track": {
      "type": "object",
      "required": [
        "scientific_or_practical_validation",
        "provenance_audit",
        "mystical_boundary_priority",
        "case_validation_recommended"
      ],
      "properties": {
        "scientific_or_practical_validation": {"type": "boolean"},
        "provenance_audit": {"type": "boolean"},
        "mystical_boundary_priority": {"type": "boolean"},
        "case_validation_recommended": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "context_files": {
      "type": "object",
      "required": ["skill", "sop", "knowledge"],
      "properties": {
        "skill": {"type": "string"},
        "sop": {"type": "array", "items": {"type": "string"}},
        "knowledge": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "initial_tools": {"type": "array", "items": {"type": "string"}},
    "limits": {"type": "array", "items": {"type": "string"}},
    "next_steps": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}

