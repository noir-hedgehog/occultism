{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpiritualProtectionReflectionPlanner",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "context_text": { "type": "string" },
    "request_text": { "type": "string" },
    "text": { "type": "string" },
    "protection_focus": { "type": "string" },
    "trigger_context": { "type": "string" },
    "sensations": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "emotions": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "reality_safety_context": { "type": "string" },
    "boundary_actions": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "symbolic_items": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "review_time": { "type": "string" },
    "stop_condition": { "type": "string" },
    "focus": { "type": "string" }
  },
  "anyOf": [
    { "required": ["context_text"] },
    { "required": ["request_text"] },
    { "required": ["text"] }
  ]
}
