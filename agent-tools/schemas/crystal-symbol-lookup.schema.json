{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CrystalSymbolLookup",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "query": { "type": "string" },
    "crystal": { "type": "string" },
    "item": { "type": "string" },
    "focus": { "type": "string" }
  },
  "anyOf": [
    { "required": ["query"] },
    { "required": ["crystal"] },
    { "required": ["item"] }
  ]
}
