{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QimenMethodGuard",
  "type": "object",
  "required": [
    "chart_method",
    "school",
    "chart_time",
    "timezone",
    "location",
    "solar_time_strategy",
    "solar_term_source",
    "dun",
    "ju",
    "can_generate_chart",
    "is_external_chart_only",
    "errors",
    "warnings",
    "assumptions",
    "required_before_generation",
    "limits",
    "next_steps"
  ],
  "properties": {
    "chart_method": {"type": "string", "enum": ["time_chart", "event_chart", "manual_external_chart"]},
    "school": {"type": "string", "enum": ["zhirun", "chaibu", "maoshan", "feipan", "turning_plate", "unspecified"]},
    "chart_time": {"type": "string"},
    "timezone": {"type": "string"},
    "location": {"type": "string"},
    "solar_time_strategy": {"type": "string", "enum": ["not_applied", "true_solar_time", "local_mean_time", "unknown"]},
    "solar_term_source": {"type": "string", "enum": ["manual", "external_calendar", "future_tool_generated", "unknown"]},
    "dun": {"type": "string"},
    "ju": {"anyOf": [{"type": "integer", "minimum": 1, "maximum": 9}, {"type": "null"}]},
    "can_generate_chart": {"type": "boolean"},
    "is_external_chart_only": {"type": "boolean"},
    "errors": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "required_before_generation": {"type": "array", "items": {"type": "string"}},
    "limits": {"type": "array", "items": {"type": "string"}},
    "next_steps": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
