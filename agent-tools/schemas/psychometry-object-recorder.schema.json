{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PsychometryObjectRecorder",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "object_text": { "type": "string" },
    "request_text": { "type": "string" },
    "text": { "type": "string" },
    "object_types": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "objects": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "source_notes": { "type": "string" },
    "source": { "type": "string" },
    "ownership_status": { "type": "string" },
    "consent_status": { "type": "string" },
    "visible_features": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "features": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "impressions": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "emotions": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "reality_anchor": { "type": "string" },
    "focus": { "type": "string" }
  },
  "anyOf": [
    { "required": ["object_text"] },
    { "required": ["request_text"] },
    { "required": ["text"] }
  ]
}
