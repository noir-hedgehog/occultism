{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HerbalContextRecorder",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "question_text": { "type": "string" },
    "request_text": { "type": "string" },
    "text": { "type": "string" },
    "plant_items": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
    "herbs": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
    "items": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
    "plant_source": { "type": "string" },
    "source": { "type": "string" },
    "use_mode": { "type": "string" },
    "method": { "type": "string" },
    "container_or_form": { "type": "string" },
    "form": { "type": "string" },
    "space": { "type": "string" },
    "location": { "type": "string" },
    "duration": { "type": "string" },
    "time_limit": { "type": "string" },
    "focus": { "type": "string" },
    "safety_context": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
    "safety_notes": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
    "reality_constraints": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
    "constraints": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
    "notes": { "type": "string" },
    "context_notes": { "type": "string" }
  },
  "anyOf": [
    { "required": ["question_text"] },
    { "required": ["request_text"] },
    { "required": ["text"] }
  ]
}
