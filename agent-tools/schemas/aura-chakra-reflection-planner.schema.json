{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuraChakraReflectionPlanner",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sensation_text": { "type": "string" },
    "request_text": { "type": "string" },
    "text": { "type": "string" },
    "centers": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "chakras": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "colors": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "sensations": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "context": { "type": "string" },
    "duration": { "type": "string" },
    "intensity": { "type": "string" },
    "grounding_notes": { "type": "string" },
    "focus": { "type": "string" }
  },
  "anyOf": [
    { "required": ["sensation_text"] },
    { "required": ["request_text"] },
    { "required": ["text"] }
  ]
}
