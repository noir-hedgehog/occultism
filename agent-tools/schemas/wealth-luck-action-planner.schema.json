{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WealthLuckActionPlanner",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "context_text": { "type": "string" },
    "request_text": { "type": "string" },
    "text": { "type": "string" },
    "wealth_focus": { "type": "string" },
    "current_context": { "type": "string" },
    "income_channels": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "budget_boundaries": { "type": "string" },
    "existing_symbols": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "practical_actions": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "risk_notes": { "type": "string" },
    "review_time": { "type": "string" },
    "stop_condition": { "type": "string" },
    "focus": { "type": "string" }
  },
  "anyOf": [
    { "required": ["context_text"] },
    { "required": ["request_text"] },
    { "required": ["text"] }
  ]
}
