{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RitualSourceExampleLookup",
  "type": "object",
  "required": [
    "source_type",
    "display_name",
    "classification_cues",
    "required_context",
    "safe_use",
    "not_allowed",
    "example_records",
    "guard_summary",
    "next_steps"
  ],
  "properties": {
    "source_type": {"type": "string", "enum": ["regional_folk", "religious_tradition", "modern_wellness", "commercial_new_age", "personal_preference", "unknown"]},
    "display_name": {"type": "string"},
    "classification_cues": {"type": "array", "items": {"type": "string"}},
    "required_context": {"type": "array", "items": {"type": "string"}},
    "safe_use": {"type": "string"},
    "not_allowed": {"type": "string"},
    "example_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_text", "safe_framing", "needs"],
        "properties": {
          "source_text": {"type": "string"},
          "safe_framing": {"type": "string"},
          "needs": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "guard_summary": {
      "type": "object",
      "required": ["source_claim_level", "missing_source_fields", "certainty_flags", "risk_level", "can_use_as_cultural_context", "can_offer_steps"],
      "properties": {
        "source_claim_level": {"type": "string"},
        "missing_source_fields": {"type": "array", "items": {"type": "string"}},
        "certainty_flags": {"type": "array", "items": {"type": "string"}},
        "risk_level": {"type": "string"},
        "can_use_as_cultural_context": {"type": "boolean"},
        "can_offer_steps": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "next_steps": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
