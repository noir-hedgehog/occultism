{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MysticOutputLint",
  "type": "object",
  "required": ["risk_level", "publishable", "findings", "required_actions"],
  "properties": {
    "risk_level": {
      "type": "string",
      "enum": ["green", "yellow", "orange", "red"]
    },
    "publishable": {
      "type": "boolean"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "severity", "message", "evidence", "suggestion"],
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": ["yellow", "orange", "red"]
          },
          "message": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "suggestion": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "required_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}

