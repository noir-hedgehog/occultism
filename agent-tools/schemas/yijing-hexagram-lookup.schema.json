{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YijingHexagramLookup",
  "type": "object",
  "required": [
    "number",
    "name",
    "short_name",
    "keywords",
    "reflection_prompt",
    "action_guidance",
    "lower_trigram",
    "upper_trigram",
    "image_name",
    "bits_bottom_to_top",
    "lookup_method",
    "line_scope",
    "limits",
    "next_steps"
  ],
  "properties": {
    "number": {"type": "integer", "minimum": 1, "maximum": 64},
    "name": {"type": "string"},
    "short_name": {"type": "string"},
    "keywords": {
      "type": "array",
      "items": {"type": "string"}
    },
    "reflection_prompt": {"type": "string"},
    "action_guidance": {"type": "string"},
    "lower_trigram": {"$ref": "#/$defs/trigram"},
    "upper_trigram": {"$ref": "#/$defs/trigram"},
    "image_name": {"type": "string"},
    "bits_bottom_to_top": {"type": "string"},
    "lookup_method": {"type": "string", "enum": ["number", "query", "trigrams"]},
    "line_scope": {
      "anyOf": [
        {
          "type": "object",
          "required": ["line", "focus", "note"],
          "properties": {
            "line": {"type": "integer", "minimum": 1, "maximum": 6},
            "focus": {"type": "string"},
            "note": {"type": "string"}
          },
          "additionalProperties": false
        },
        {"type": "null"}
      ]
    },
    "limits": {
      "type": "array",
      "items": {"type": "string"}
    },
    "next_steps": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "trigram": {
      "type": "object",
      "required": ["bits", "name", "image", "symbol"],
      "properties": {
        "bits": {"type": "string"},
        "name": {"type": "string"},
        "image": {"type": "string"},
        "symbol": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
