{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeityAncestorReflectionPlanner",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "context_text": { "type": "string" },
    "request_text": { "type": "string" },
    "text": { "type": "string" },
    "tradition_context": { "type": "string" },
    "focus_entity": { "type": "string" },
    "occasion": { "type": "string" },
    "user_intention": { "type": "string" },
    "existing_items": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "offering_or_memorial_actions": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "household_boundaries": { "type": "string" },
    "safety_context": { "type": "string" },
    "review_time": { "type": "string" },
    "stop_condition": { "type": "string" },
    "focus": { "type": "string" }
  },
  "anyOf": [
    { "required": ["context_text"] },
    { "required": ["request_text"] },
    { "required": ["text"] }
  ]
}
